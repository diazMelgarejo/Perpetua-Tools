# Perpetua-Tools local environment overrides
# Copy to .env.local and fill in values — never commit .env.local

# Exa.ai — https://dashboard.exa.ai/keys
EXA_API_KEY=

# OpenRouter — paid Tier-5 provider. Secret authority stays in PT.
OPENROUTER_API_KEY=
# Governed Tier-5 recipes are opt-in even when a key is present.
PIPELINE_TIERED_ENABLED=0

# ── LAN mesh gossip (required when PT_BIND_LAN=1) ─────────────────────────────
# Generate locally (never commit the value):
#   python3 scripts/mesh/ensure_local_mesh_secrets.py
# Pair with orama-system sibling:
#   ORAMA_SYSTEM_PATH=/path/to/orama-system  # optional bidirectional harmonize
#   PERPETUA_TOOLS_PATH on orama side harmonizes this file automatically
# Logs: .local/mesh.log (gitignored, Windows + Unix)
# GOSSIP_SHARED_SECRET=

# PT_BIND_LAN=1  # expose orchestrator on LAN — requires GOSSIP_SHARED_SECRET above
