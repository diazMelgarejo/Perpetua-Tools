{"id": "lesson_8c228d4bfa25", "claim": "On Windows fsnotify remove or rename events, retain watcher ownership and budget cleanup but do not call the native Remove API again for an already invalidated watch: the redundant call can block watcher shutdown. Prove the event-ordering fix with a regression that observes no second native removal.", "conditions": ["fsnotify", "invalidated-watch", "regression", "watcher-deadlock", "windows"], "evidence_ids": ["2026-09-03T19:48:56.976035+00:00"], "status": "accepted", "accepted_at": "2026-09-03T19:48:57.047405+00:00", "reviewer": "learn.py", "rationale": "Separated from lesson_757476abb44e so its verified watcher-deadlock root cause remains available after the authorization-only supersession.", "cluster_size": 1, "canonical_salience": 8.0, "confidence": 0.6, "support_count": 0, "contradiction_count": 0, "supersedes": null, "source_candidate": "8c228d4bfa25"}
