{"timestamp": "2026-08-22T21:27:10.499691+00:00", "skill": "learn", "action": "manual-stage:b696555249a3", "result": "success", "detail": "Manually staged lesson b696555249a3 via .agent/tools/learn.py: \"GitHub Dependabot alerts reflect the DEFAULT BRANCH only -- a dependency fix already landed and pushed on a feature branch does not clear the alert until that branch merges to main; don't report alerts 'resolved' based on feature-branch state\"", "pain_score": 1, "importance": 6, "reflection": "", "confidence": 0.9, "source": {"skill": "learn", "profile": "manual", "run_id": "manual_b69655"}, "evidence_ids": ["2026-08-22T21:27:10.499691+00:00"]}
