{
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git rev-parse *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr diff *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(find *)",
      "Bash(jq *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(gbrain sources list *)",
      "Bash(gbrain search *)",
      "Bash(openclaw agents list *)",
      "Bash(openclaw status *)",
      "Bash(gbrain doctor *)",
      "Bash(openclaw agent --help)",
      "Bash(gbrain --version)",
      "mcp__github-copilot__get_file_contents",
      "mcp__gbrain__query",
      "mcp__code-review-graph__list_graph_stats_tool",
      "mcp__code-review-graph__detect_changes_tool",
      "mcp__gbrain__run_doctor"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/discover-lm-studio.sh 2>&1 | grep -v '^$' || true",
            "statusMessage": "Discovering LM Studio endpoints...",
            "async": true
          },
          {
            "type": "command",
            "command": "bash scripts/sync-companion-instincts.sh 2>/dev/null || true",
            "statusMessage": "Syncing companion instincts...",
            "async": true
          },
          {
            "type": "command",
            "command": "echo '\ud83d\udca1 Skills: /self-discovery  /agent-run  /model-routing-check' || true",
            "statusMessage": "Skills ready",
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "file=$(python3 -c \"import sys,json,os; print(json.loads(os.environ.get('CLAUDE_TOOL_INPUT','{}')).get('file_path',''))\" 2>/dev/null || echo ''); [[ \"$file\" == *.py ]] && ruff check \"$file\" 2>&1 | head -10 || true"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "[[ -f pyproject.toml ]] && python -m pytest tests/ -x -q --tb=short 2>&1 | tail -12 || true"
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .agent/harness/hooks/claude_code_post_tool.py 2>/dev/null || true",
            "async": true
          }
        ]
      }
    ]
  }
}