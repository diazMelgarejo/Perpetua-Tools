#!/usr/bin/env bash
# Block push if any outgoing commit message contains banned Co-authored-by trailers.
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"
zero="0000000000000000000000000000000000000000"

push_refs="$(mktemp)"
trap 'rm -f "$push_refs"' EXIT
cat >"$push_refs"

# Guard-sync manifest: single source of truth for which scripts/git/ and
# .githooks/ paths are actually manifest-managed guard tooling. Used below
# to trigger the cross-worktree divergence scan on an EXACT membership
# check instead of "lives anywhere under scripts/git/" — see ECC push-gate
# analysis 2026-08-14 § Root Cause. A helper script that merely lives in
# the same directory as the guards (e.g. ecc-submodule-sync.sh) must not
# drag in a scan whose whole purpose is protecting the guard files
# themselves.
_GUARD_MANIFEST_LOADED=0
if [[ -f "$ROOT/scripts/git/guard-sync-manifest.sh" ]]; then
  # shellcheck source=scripts/git/guard-sync-manifest.sh
  source "$ROOT/scripts/git/guard-sync-manifest.sh"
  _GUARD_MANIFEST_LOADED=1
fi

_is_guard_managed_path() {
  local path="$1" e
  if [[ "$_GUARD_MANIFEST_LOADED" == "1" ]]; then
    for e in "${GUARD_PARITY_REQUIRED[@]}"; do
      [[ "$path" == "scripts/git/$e" ]] && return 0
    done
    for e in "${GUARD_SYNC_GITHOOKS[@]}"; do
      [[ "$path" == ".githooks/$e" ]] && return 0
    done
    return 1
  fi
  # Manifest unavailable — fail closed to the old, broader directory-wide
  # trigger rather than silently skipping the divergence check entirely.
  # Must cover .githooks/ too, not just scripts/git/: the manifest governs
  # both (GUARD_SYNC_GITHOOKS), so a degraded fallback that only matched
  # scripts/git/ would let a manifest-managed githook change (e.g.
  # .githooks/commit-msg) skip divergence validation exactly when the
  # manifest is unavailable — fail-open in precisely the case meant to be
  # the safety net (caught in review, PR 311).
  [[ "$path" =~ ^(scripts/git/|\.githooks/) ]]
}

# Guard: scrub macOS .DS_Store from .git/ internals (see scrub_dsstore.sh).
if [[ -x "$ROOT/scripts/git/scrub_dsstore.sh" ]]; then
  bash "$ROOT/scripts/git/scrub_dsstore.sh" || true
fi

# Guard: never push while a --no-commit merge/cherry-pick/revert is still
# uncommitted (see check_no_pending_merge.sh for the incident this prevents).
"$ROOT/scripts/git/check_no_pending_merge.sh" "$ROOT" || exit $?

"$ROOT/scripts/git/ensure_hooks_installed.sh"

upstream_ref="${GIT_PUSH_UPSTREAM:-origin/main}"

range_for_ref() {
  local local_oid="$1"
  local remote_oid="$2"
  if [[ "$remote_oid" == "$zero" ]]; then
    local upstream_oid
    if upstream_oid="$(git rev-parse --verify "$upstream_ref" 2>/dev/null)"; then
      printf '%s..%s\n' "$upstream_oid" "$local_oid"
    else
      echo "${local_oid}"
    fi
  else
    echo "${remote_oid}..${local_oid}"
  fi
}

audit_range_for_ref() {
  local local_oid="$1"
  local remote_oid="$2"
  local upstream_oid base_oid tree_oid
  local -a parents=()

  if ! upstream_oid="$(git rev-parse --verify "$upstream_ref" 2>/dev/null)"; then
    echo "pre-push: blocked — $upstream_ref is unavailable; fetch origin/main before pushing" >&2
    return 1
  fi

  parents+=("-p" "$upstream_oid")
  if [[ "$remote_oid" != "$zero" && "$remote_oid" != "$upstream_oid" ]]; then
    parents+=("-p" "$remote_oid")
  fi

  tree_oid="$(git rev-parse "$local_oid^{tree}")"
  base_oid="$(git commit-tree "$tree_oid" "${parents[@]}" -m "pre-push attribution audit base")"
  printf '%s..%s\n' "$base_oid" "$local_oid"
}

# Guard-sync anti-clobber: block push when siblings carry guard mutations absent
# from canonical history (see check-guard-sync-divergence.sh).
guard_touch=0
while read -r local_ref local_oid remote_ref remote_oid; do
  [[ "$local_ref" =~ refs/heads/ ]] || continue
  [[ "$local_oid" == "$zero" ]] && continue

  guard_range="$(range_for_ref "$local_oid" "$remote_oid")"

  guard_commits="$(git rev-list "$guard_range" 2>/dev/null)" || continue
  if [[ -z "$guard_commits" ]]; then
    continue
  fi

  while read -r sha; do
    [[ -z "$sha" ]] && continue
    changed_paths="$(git diff-tree --no-commit-id --name-only -r "$sha" 2>/dev/null)" || continue
    [[ -z "$changed_paths" ]] && continue
    while IFS= read -r changed_path; do
      [[ -z "$changed_path" ]] && continue
      if _is_guard_managed_path "$changed_path"; then
        guard_touch=1
        break 3
      fi
    done <<<"$changed_paths"
  done <<<"$guard_commits"
done <"$push_refs"

if [[ "$guard_touch" == "1" ]] && [[ "${GUARD_SYNC_SKIP_DIVERGENCE_CHECK:-0}" != "1" ]]; then
  if [[ ! -x "$ROOT/scripts/git/check-guard-sync-divergence.sh" ]]; then
    echo "pre-push: blocked — check-guard-sync-divergence.sh missing or not executable" >&2
    exit 1
  fi
  WORKSPACE_ROOT="${WORKSPACE_ROOT:-$(cd "$ROOT/.." && pwd)}" \
    bash "$ROOT/scripts/git/check-guard-sync-divergence.sh" --workspace || {
    echo "pre-push: blocked — guard-sync divergence (promote siblings upstream first)" >&2
    echo "  See: bin/orama-system/skills/guard-sync-divergence-guard/SKILL.md" >&2
    exit 1
  }
fi

if [[ -x scripts/cursor/sync-private-attribution-from-home.sh ]]; then
  bash scripts/cursor/sync-private-attribution-from-home.sh >/dev/null 2>&1 || true
fi

# Phase 0 (Post-Review Micro-Remediation doctrine): the reviewed PR branch is
# the only write target until review is complete — direct pushes to main
# must be an explicit, deliberate act, never an accident of habit or a
# mistyped destination. This is advisory (bypassable with --no-verify, like
# any local hook); the durable enforcement is GitHub branch protection on
# main, which must be configured in repo Settings (a token without
# `administration` scope cannot set this via API — verified 2026-07-13).
# Escape hatch for genuine direct-to-main work: ALLOW_MAIN_PUSH=1 git push …
MAIN_PUSH_GUARD_REF_RE='refs/heads/(main|master)$'

while read -r local_ref local_oid remote_ref remote_oid; do
  [[ "$local_ref" =~ refs/heads/ ]] || continue
  [[ "$local_oid" == "$zero" ]] && continue

  if [[ "$remote_ref" =~ $MAIN_PUSH_GUARD_REF_RE ]] && [[ "${ALLOW_MAIN_PUSH:-0}" != "1" ]]; then
    echo "pre-push: blocked — direct push to ${remote_ref#refs/heads/} is disabled by Phase 0" >&2
    echo "  (Post-Review Micro-Remediation doctrine: the PR branch is the only" >&2
    echo "   write target until review is complete — see references/post-review-micro-remediation.md)" >&2
    echo "  Merge via the PR instead, or if this is genuinely intentional:" >&2
    echo "    ALLOW_MAIN_PUSH=1 git push $remote_ref ..." >&2
    exit 1
  fi

  range="$(range_for_ref "$local_oid" "$remote_oid")"

  range_commits="$(git rev-list "$range" 2>/dev/null)" || continue
  if [[ -z "$range_commits" ]]; then
    continue
  fi

  audit_range="$(audit_range_for_ref "$local_oid" "$remote_oid")" || exit $?
  audit_commits="$(git rev-list "$audit_range" 2>/dev/null)" || continue
  if [[ -z "$audit_commits" ]]; then
    continue
  fi

  if ! GIT_AUDIT_RANGE="$audit_range" GIT_AUDIT_STRICT=1 bash "$ROOT/scripts/git/audit_attribution.sh"; then
    echo "pre-push: blocked — banned or unapproved attribution in commits to push" >&2
    echo "Use: bash scripts/git/publish-clean-branch.sh <branch>" >&2
    exit 1
  fi
done <"$push_refs"

exit 0
