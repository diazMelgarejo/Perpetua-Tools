#!/usr/bin/env bash
# Parallel pre-commit gate runner.
#
# Pattern source: orama-system agent-security CI — "split the invocation,
# not the gate logic" (docs/v2/plans/2026-08-20-agent-security-ci-runtime-
# efficiency.md): each gate is one implementation in scripts/hooks/
# run_gates.sh, invoked by name. Local parallelism uses background jobs
# (gates are independent reads of the staged tree); CI runs the same gates
# as separate parallel jobs via the same dispatcher, so hook and CI can
# never drift.
set -uo pipefail
ROOT="$(git rev-parse --show-toplevel)"
DISPATCH="$ROOT/scripts/hooks/run_gates.sh"

# --- sequential pre-pass (cheap, side-effecting): scrub .DS_Store ---
if [[ -x "$ROOT/scripts/git/scrub_dsstore.sh" ]]; then
  bash "$ROOT/scripts/git/scrub_dsstore.sh" || true
fi

if ! command -v python3 >/dev/null 2>&1; then
  echo "error: python3 is required for the pre-commit gates" >&2
  echo "error: run 'git commit --no-verify' only if you accept the risk" >&2
  exit 1
fi

GATE_NAMES=()
GATE_PIDS=()
GATE_LOGS=()

gate() {
  local name="$1"; shift
  local log
  log="$(mktemp -t pt-gate.XXXXXX)"
  GATE_NAMES+=("$name")
  GATE_LOGS+=("$log")
  ( bash "$DISPATCH" "$@" ) >"$log" 2>&1 &
  GATE_PIDS+=("$!")
}

if [ -f "$ROOT/scripts/hooks/no_committed_lan_topology.py" ]; then
  gate lan-topology lan-topology
fi

gate memory-records memory-records

if [ -f "$ROOT/scripts/review/repo_hygiene.py" ]; then
  gate repo-hygiene repo-hygiene "$ROOT"
fi

BASE="$(git merge-base origin/main HEAD 2>/dev/null || git rev-parse HEAD)"
gate episodic-append-only episodic-append-only --base "$BASE" --worktree

FAILED=0
for i in "${!GATE_NAMES[@]}"; do
  name="${GATE_NAMES[$i]}"
  pid="${GATE_PIDS[$i]}"
  log="${GATE_LOGS[$i]}"
  if wait "$pid"; then
    echo "PASS: $name"
  else
    echo "FAIL: $name" >&2
    sed 's/^/    /' "$log" >&2
    FAILED=1
  fi
  rm -f "$log"
done

if [ "$FAILED" -ne 0 ]; then
  echo "pre-commit: one or more gates failed; commit rejected" >&2
  echo "pre-commit: fix the failures or use 'git commit --no-verify' only if you accept the risk" >&2
  exit 1
fi
exit 0
