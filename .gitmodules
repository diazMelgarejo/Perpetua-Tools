[submodule "vendor/agentic-stack"]
	path = vendor/agentic-stack
	# All 4 fixes from the 2026-08-07 fork-pin (PRs #60, #61, #62, plus the
	# upgrade.py loop-skill path bug contributed as #63) merged upstream the
	# same day and shipped in v0.19.1. Reverted to the real upstream url and
	# re-pinned to origin master's tip. See
	# .agent/.agentic-stack-blend-state.json last_blend.note for provenance.
	url = https://github.com/codejunkie99/agentic-stack
	ignore = dirty

[submodule "vendor/ecc-tools"]
	path = vendor/ecc-tools
	url = https://github.com/affaan-m/everything-claude-code.git
	ignore = dirty
[submodule "vendor/Claude-Desktop-LLM"]
	path = vendor/Claude-Desktop-LLM
	url = https://github.com/yayoboy/Claude-Desktop-LLM.git
	ignore = dirty

[submodule "vendor/autoresearch"]
	path = vendor/autoresearch
	url = https://github.com/uditgoenka/autoresearch.git
	branch = master
	ignore = dirty
