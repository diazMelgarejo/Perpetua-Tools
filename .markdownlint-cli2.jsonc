{
  "$schema": "https://raw.githubusercontent.com/DavidAnson/markdownlint-cli2/main/schema/markdownlint-cli2-config-schema.json",
  "config": {
    "default": true,
    "MD013": {
      "line_length": 100,
      "heading_line_length": 120,
      "code_blocks": false,
      "tables": false,
      "strict": false,
      "stern": false
    }
  },
  "overrides": [
    {
      "filter": [
        "SKILL.md",
        "**/SKILL.md",
        "**/skills/**"
      ],
      "config": {
        "MD013": false
      },
      "combine": "merge"
    }
  ]
}
